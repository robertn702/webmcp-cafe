{
  "name": "@webmcp-today/mcp-bridge",
  "mcpName": "io.github.robertn702/webmcp-today",
  "version": "0.3.1",
  "description": "MCP server for the WebMCP Today registry and local browser bridge — manage packages and list or execute live WebMCP tools",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/webmcp-today.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "webmcp-today-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "LICENSES",
    "THIRD-PARTY-LICENSES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-native-host.mjs",
    "prepack": "bunx turbo run build --filter=@webmcp-today/mcp-bridge...",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@webmcp-today/schema": "0.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
