{
  "name": "@webmcp-today/engine",
  "version": "0.1.0",
  "description": "Execution engine for WebMCP Today — runs a package's declarative api block as HTTP requests",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertn702/webmcp-today.git",
    "directory": "packages/engine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "bunx turbo run build --filter=@webmcp-today/engine...",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jmespath-community/jmespath": "1.3.0",
    "@webmcp-today/schema": "0.3.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
